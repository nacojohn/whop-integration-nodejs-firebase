# Copy to functions/.secret.local for the local emulator (git-ignored).
# The emulator reads defineSecret() values from .secret.local.
# In production, set them with: firebase functions:secrets:set WHOP_API_KEY
#
# Sandbox key: sandbox.whop.com/dashboard/developer
WHOP_API_KEY=
# ws_… shown once when you create the webhook
WHOP_WEBHOOK_SECRET=
